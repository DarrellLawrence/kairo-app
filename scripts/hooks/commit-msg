#!/bin/sh
# Kairo commit-msg: a personal term or a secret in a commit message stays in the history for good, so it is
# checked here too. Turn it on with:   git config core.hooksPath scripts/hooks
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

py=
for cand in python3 python py; do
  if command -v "$cand" >/dev/null 2>&1 \
     && "$cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    py=$cand
    break
  fi
done
if [ -z "$py" ]; then
  echo "commit-msg: Python 3 was not found, so the privacy scan cannot run. Install Python 3, or commit with --no-verify." >&2
  exit 1
fi

"$py" scripts/privacy_scan.py --message-file "$1" || {
  echo "commit-msg: the privacy scan found something in the commit message. Nothing was committed." >&2
  exit 1
}
exit 0
