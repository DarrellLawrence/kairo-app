#!/bin/sh
# Kairo pre-commit: stops personal data and secrets before they are committed.
# Turn it on once per clone:   git config core.hooksPath scripts/hooks
# It runs scripts/privacy_scan.py --staged, and gitleaks too if gitleaks is installed.
# Skipping it (git commit --no-verify) is possible, but CI scans the whole history again.
# Git for Windows runs this file through its own sh, so no .cmd or .ps1 is needed.

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

py=
for cand in python3 python py; do
  if command -v "$cand" >/dev/null 2>&1 \
     && "$cand" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    py=$cand
    break
  fi
done
if [ -z "$py" ]; then
  echo "pre-commit: Python 3 was not found, so the privacy scan cannot run. Install Python 3, or commit with --no-verify." >&2
  exit 1
fi

"$py" scripts/privacy_scan.py --staged || {
  echo "pre-commit: the privacy scan found something (see above). Nothing was committed." >&2
  exit 1
}

if command -v gitleaks >/dev/null 2>&1; then
  if gitleaks git --help >/dev/null 2>&1; then
    gitleaks git --staged --pre-commit --redact --no-banner -l warn || exit 1      # gitleaks 8.19 and newer
  else
    gitleaks protect --staged --redact --no-banner -l warn || exit 1               # older gitleaks
  fi
fi
exit 0
