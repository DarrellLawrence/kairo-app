#!/bin/sh
# Kairo commit-msg: a personal term or a secret in a commit message stays in the history for good, so it is
# checked here too. Turn it on with:   git config core.hooksPath scripts/hooks
# Every line of the message is scanned: with -m, -F and git merge -m git keeps lines that start with # and the text
# below a scissors line. Only when an editor was opened are the lines git itself put into the file left out, and
# only while they still stand unchanged at the end (prepare-commit-msg saved the file as git handed it over).

here=$(cd "$(dirname "$0")" && pwd) || exit 1
. "$here/_common.sh" || exit 1
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
gd=$(git rev-parse --git-dir) || exit 1
kairo_find_python commit-msg || exit 1
kairo_find_scanner commit-msg "$root" "$here" || exit 1

prepared="$gd/kairo-msg-prepared"
if [ "${GIT_EDITOR-}" != ":" ] && [ -f "$prepared" ]; then
  "$py" "$scan" --message-file "$1" --message-prepared "$prepared"
else
  "$py" "$scan" --message-file "$1"
fi
rc=$?
rm -f "$prepared"
if [ "$rc" -ne 0 ]; then
  echo "commit-msg: the privacy scan found something in the commit message (see above). Nothing was committed." >&2
  exit 1
fi
exit 0
