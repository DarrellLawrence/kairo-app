# Copy to .env and fill in. .env is never committed.
# Paths are inside the container unless noted.

# --- Host side (docker compose) ---
# Where /srv/kairo lives on the host. Dev: ./devdata   Prod (kairo-home): /srv/kairo
KAIRO_HOST_DATA_DIR=./devdata
# Must match the owner of KAIRO_HOST_DATA_DIR on the host (`id -u`, `id -g`).
KAIRO_UID=1000
KAIRO_GID=1000

# --- App ---
KAIRO_BRAIN=claude_cli
KAIRO_CLAUDE_BIN=claude
KAIRO_BRAIN_TIMEOUT_S=300

# --- Deploy (laptop only, read by scripts/deploy.sh) ---
KAIRO_DEPLOY_HOST=kairo-home
KAIRO_DEPLOY_DIR=/opt/kairo
