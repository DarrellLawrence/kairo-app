# Guard rails against personal data and secrets (owner's master prompt 0.6). scripts/privacy_scan.py fails on any of
# these paths in a commit, the history or a release, even if someone adds one with -f.
.env.*
!.env.example
data/
*.local.*
personal-terms*.txt
*.sqlite*
*.db
*.db3
secrets/
vault/
.private/
*.env
.envrc
.env-*
capture-token*

# The voice latency harness (bench/): its results and rendered clips live in the data folder; a run that
# writes into a checkout leaves nothing in git but the README.
bench/results/*
!bench/results/.gitkeep
!bench/results/README.md
